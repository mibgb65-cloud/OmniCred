# Runtime data
/data/*
!/data/.gitkeep
*.db
*.db-shm
*.db-wal

# Go build output
/.cache/
/bin/
/build/bin/
/build/windows/installer/wails_tools.nsh
/build/windows/installer/tmp/
*.exe
*.test
coverage.out

# Frontend dependencies and build output
/frontend/node_modules/
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/package.json.md5
/frontend/wailsjs/
/coverage/

# Local environment and editor files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.idea/
.vscode/
